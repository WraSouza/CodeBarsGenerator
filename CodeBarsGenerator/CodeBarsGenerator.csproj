<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c94864d0-6e2e-4b52-9907-01143cba5a33</UserSecretsId>
  
  <!-- Metadados do pacote NuGet --> 
  <GeneratePackageOnBuild>true</GeneratePackageOnBuild> 
  <PackageId>BarcodeLib</PackageId>
  <Version>1.0.0</Version> 
  <Authors>Wladimir</Authors> 
  <Company>Wladimir</Company>
  <Description>Biblioteca para geração de códigos de barras e QR Codes usando ZXing e SkiaSharp.</Description>
  <PackageTags>barcode qrcode zxing skia</PackageTags>
  <RepositoryUrl>https://github.com/WraSouza/BarcodeLib</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" Version="8.1.1" />
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.12.52" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.1.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.1.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.4" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.22" />

    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
  </ItemGroup>

</Project>
